import "../main.nx"

func main() {
    var t = newTest("nyxilum-assert: самоперевірка")

    t.assertEqual(2 + 2, 4, "додавання")
    t.assertEqual("а" + "б", "аб", "конкатенація рядків")
    t.assertNotEqual(5, 6, "assertNotEqual на різних значеннях")
    t.assertTrue(3 > 1, "assertTrue на істинній умові")
    t.assertFalse(1 > 3, "assertFalse на хибній умові")
    t.assertNull(null, "assertNull на null")

    var arr1 = [1, 2, 3]
    var arr2 = [1, 2, 3]
    t.assertArrayEqual(arr1, arr2, "однакові масиви")

    // Регресія: == на масивах/мапах порівнює ПОСИЛАННЯ, не вміст, тож
    // [1,[2,3]] != [1,[2,3]] (два різні об'єкти-літерали) - deepEqual()
    // всередині assertArrayEqual/assertMapEqual мав це виправити.
    t.assertArrayEqual([1, [2, 3]], [1, [2, 3]], "вкладені масиви - однакові")
    // "Мав відрізнятись" перевіряємо через сам deepEqual(), а не
    // assertArrayEqual - інакше навмисний негативний кейс збільшив би
    // t.failed і провалив би весь файл через exit(1) унизу.
    t.assertFalse(deepEqual([1, [2, 3]], [1, [2, 4]]), "вкладені масиви - deepEqual бачить різницю")

    var map1 = newMap()
    mapSet(map1, "a", 1)
    mapSet(map1, "b", 2)
    var map2 = newMap()
    mapSet(map2, "b", 2)
    mapSet(map2, "a", 1)
    t.assertMapEqual(map1, map2, "однакові мапи (інший порядок вставки)")

    var mapNested1 = newMap()
    mapSet(mapNested1, "list", [1, 2])
    var mapNested2 = newMap()
    mapSet(mapNested2, "list", [1, 2])
    t.assertMapEqual(mapNested1, mapNested2, "мапи з вкладеними масивами - однакові")

    var mapNested3 = newMap()
    mapSet(mapNested3, "list", [9, 9])
    t.assertFalse(deepEqual(mapNested1, mapNested3), "мапи з вкладеними масивами - deepEqual бачить різницю")

    func boom() {
        throw "бум"
    }
    t.assertThrows(boom, "assertThrows ловить throw")

    t.summary()
    if t.failed > 0 {
        exit(1)
    }
}

main()
