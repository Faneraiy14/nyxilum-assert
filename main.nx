// nyxilum-assert — маленька бібліотека тверджень для тестів на NyxilumLang.
//
// Досі тести самої мови писались вручну через if/print("ok")/print("ПРОВАЛ")
// в кожному файлі окремо — ця бібліотека виносить той самий патерн у
// перевикористовувані функції з рахунком пройдених/провалених перевірок.
//
// Використання:
//   import "nyxilum-assert"
//
//   func main() {
//       var t = newTest("моя перевірка")
//       assertEqual(t, 2 + 2, 4, "додавання")
//       assertTrue(t, len([1,2,3]) == 3, "довжина масиву")
//       testSummary(t)
//   }

struct TestState {
    passed: i32
    failed: i32
    name: string
}

func newTest(name) {
    print("=== " + name + " ===")
    return TestState { passed: 0, failed: 0, name: name }
}

func TestState.assertEqual(actual, expected, label) {
    if actual == expected {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    } else {
        print("  ✗ " + label + " (очікувалось " + toString(expected) + ", отримано " + toString(actual) + ")")
        self.failed = self.failed + 1
    }
}

func TestState.assertNotEqual(actual, unexpected, label) {
    if actual == unexpected {
        print("  ✗ " + label + " (значення НЕ мало дорівнювати " + toString(unexpected) + ")")
        self.failed = self.failed + 1
    } else {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    }
}

func TestState.assertTrue(condition, label) {
    if condition {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    } else {
        print("  ✗ " + label + " (очікувалось true)")
        self.failed = self.failed + 1
    }
}

func TestState.assertFalse(condition, label) {
    self.assertTrue(!condition, label)
}

func TestState.assertNull(value, label) {
    self.assertTrue(isNull(value), label)
}

// == / != на масивах і мапах у NyxilumLang порівнюють ПОСИЛАННЯ, не
// вміст (те саме, що вже застерігав старий коментар тут) - тому
// [1,[2,3]] != [1,[2,3]] навіть коли елементи структурно ідентичні:
// вкладені масиви-літерали - це два різні об'єкти. deepEqual()
// рекурсивно порівнює вміст масивів/мап, а не посилання, і на
// примітивах (числа/рядки/bool) просто падає назад на ==.
func deepEqual(a, b) {
    if isArray(a) && isArray(b) {
        if len(a) != len(b) {
            return false
        }
        var i = 0
        while i < len(a) {
            if !deepEqual(a[i], b[i]) {
                return false
            }
            i = i + 1
        }
        return true
    }
    if typeOf(a) == "map" && typeOf(b) == "map" {
        var keysA = mapKeys(a)
        var keysB = mapKeys(b)
        if len(keysA) != len(keysB) {
            return false
        }
        var i = 0
        while i < len(keysA) {
            var k = keysA[i]
            if !mapHas(b, k) || !deepEqual(mapGet(a, k), mapGet(b, k)) {
                return false
            }
            i = i + 1
        }
        return true
    }
    return a == b
}

// Порівнює масиви поелементно через deepEqual (не == напряму — той
// порівнював би вкладені масиви/мапи за посиланням, не вмістом) —
// окрема перевірка довжини й кожного елемента з понятним повідомленням,
// а не просто "false".
func TestState.assertArrayEqual(actual, expected, label) {
    if len(actual) != len(expected) {
        print("  ✗ " + label + " (різна довжина: " + toString(len(actual)) + " проти " + toString(len(expected)) + ")")
        self.failed = self.failed + 1
        return
    }
    var i = 0
    var allMatch = true
    while i < len(actual) {
        if !deepEqual(actual[i], expected[i]) {
            allMatch = false
        }
        i = i + 1
    }
    if allMatch {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    } else {
        print("  ✗ " + label + " (елементи не збігаються)")
        self.failed = self.failed + 1
    }
}

// Порівнює мапи за ключами й значеннями (== для мап так само порівнював
// би посилання) — спершу кількість ключів, потім кожне значення окремо,
// щоб повідомлення не звелось до просто "false".
func TestState.assertMapEqual(actual, expected, label) {
    var keysA = mapKeys(actual)
    var keysE = mapKeys(expected)
    if len(keysA) != len(keysE) {
        print("  ✗ " + label + " (різна кількість ключів: " + toString(len(keysA)) + " проти " + toString(len(keysE)) + ")")
        self.failed = self.failed + 1
        return
    }
    var i = 0
    var allMatch = true
    while i < len(keysA) {
        var k = keysA[i]
        if !mapHas(expected, k) || !deepEqual(mapGet(actual, k), mapGet(expected, k)) {
            allMatch = false
        }
        i = i + 1
    }
    if allMatch {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    } else {
        print("  ✗ " + label + " (значення мап не збігаються)")
        self.failed = self.failed + 1
    }
}

// fn - функція без аргументів (значення, як у sort(arr,cmp)); очікується,
// що виклик fn() кине помилку. На відміну від вбудованого lib/testing.nx
// (де провал одразу throw), тут провал лише рахується - узгоджено з
// рештою TestState, де жодна інша перевірка теж не кидає.
func TestState.assertThrows(fn, label) {
    var threw = false
    try {
        fn()
    } catch (e) {
        threw = true
    }
    if threw {
        print("  ✓ " + label)
        self.passed = self.passed + 1
    } else {
        print("  ✗ " + label + " (очікувався throw, але його не було)")
        self.failed = self.failed + 1
    }
}

func TestState.summary() {
    var total = self.passed + self.failed
    print("")
    print(self.name + ": " + toString(self.passed) + "/" + toString(total) + " пройдено")
    if self.failed > 0 {
        print("Є провалені перевірки (" + toString(self.failed) + ").")
    } else {
        print("Усі перевірки пройдено.")
    }
}
